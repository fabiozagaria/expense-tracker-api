# Variabili obbligatorie per Docker Compose; compilare in .env, mai versionare segreti.
# Password dell'utente PostgreSQL applicativo expense_tracker (anche proprietario del database).
DB_PASSWORD=
# Chiave JWT casuale di almeno 32 byte, stabile tra i riavvii.
SECRET_KEY=
# Maven non carica automaticamente .env: vedere il percorso nativo nel README.

# Opzioni email: SMTP/Mailpit locale; Brevo HTTPS nel deploy esistente.
MAIL_PROVIDER=smtp
MAIL_FROM=noreply@expense-tracker.local
MAIL_FROM_NAME=Gestionale Spese
BREVO_API_KEY=
