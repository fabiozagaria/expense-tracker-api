# Variabili obbligatorie per Docker Compose; compilare in .env, mai versionare segreti.
# Password dell'utente MySQL applicativo expense_tracker.
DB_PASSWORD=
# Password distinta per l'amministratore MySQL (inizializzazione del volume).
MYSQL_ROOT_PASSWORD=
# Chiave JWT casuale di almeno 32 byte, stabile tra i riavvii.
SECRET_KEY=
# Maven non carica automaticamente .env: vedere il percorso nativo nel README.
